# Configuración del Backend Django & Django REST Framework - BrigadaHostel
DEBUG=True
SECRET_KEY=django-insecure-brigada-hostel-secret-key-2026-xyz!
ALLOWED_HOSTS=*

# Motor de Base de Datos: MariaDB / MySQL (cambiar a 'sqlite' solo si no se dispone de servidor)
DB_ENGINE=mariadb
DB_NAME=brigada_hostel_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend Origin (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
